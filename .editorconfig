# EditorConfig — https://editorconfig.org
# Mirrors the repos' formatters (Ruff, Prettier, gofmt). JetBrains IDEs and
# VS Code honor this automatically.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4

[*.go]
indent_style = tab
max_line_length = off

[{Makefile,*.mk,*.mak}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false  # trailing two spaces = hard line break in Markdown

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2
